import random

cafe_means = [7,10,4]
cafe_devs = [3,10,6]

def generateNewHappiness(cafeteria):
    mean = cafe_means[cafeteria -1]
    dev = cafe_devs[cafeteria-1]
    happiness = random.normalvariate(mean,dev)
    return happiness

#starts another function
def explore_only():
    #setting up a counter variable (total happiness) to keep track of happiness values
    totalhappiness = 0

    for cafeteria in range (1, 4):
        # runs another loop inside cafeteria loop, runs 100 times for each cafeteria
        for day in range(100):
            #calls function from before, makes a new random happiness number each day
            happiness = generateNewHappiness(cafeteria)
            #shortcut for totalHappiness = totalHappiness + happiness, adds daily happiness value
            totalhappiness += happiness
    #after finishing all loops, the function spits out the final sum of happiness
    return totalhappiness




# ---------------------------------------
# Function: exploitOnly
# Description:
#   This function simulates the "exploit only" strategy for t days.
#   Step 1: Visit each cafeteria once to test them.
#   Step 2: Pick the cafeteria with the highest happiness score.
#   Step 3: Visit only that cafeteria for the rest of the days.
#   Returns:
#       The total happiness accumulated over the t days.
# ---------------------------------------
def exploit_only(t):
    # Start total happiness at 0
    total_happiness = 0.0

    # --- Step 1: Exploration phase (first 3 days) ---
    first_three = []
    for i in range(3):
        # Generate random happiness score for each cafeteria
        sample = random.normalvariate(cafe_means[i], cafe_devs[i])
        first_three.append(sample)
        total_happiness += sample

    # --- Step 2: Find cafeteria with highest initial happiness ---
    best_index = first_three.index(max(first_three))  # 0, 1, or 2

    # --- Step 3: Exploitation phase (remaining days) ---
    for _ in range(t - 3):
        sample = random.normalvariate(cafe_means[best_index], cafe_devs[best_index])
        total_happiness += sample

    # Return only the total happiness (as required)
    return total_happiness





def eGreedy(cafe_means, cafe_dev, visits, e=10):
#Simulate the E-Greedy strategy:
#With probability e% explore randomly, otherwise exploit the best cafe so far
    total = 0
    # keeps track of how many times each cafe was visited and its average happiness so far
    counts = [0, 0, 0]
    averages = [0.0, 0.0, 0.0]
    for day in range(visits):
        if day < 3:  # visit each cafe once first to get a starting average
            idx = day
        elif random.random() < e / 100:  # Explore
            idx = random.randint(0, len(cafe_means) - 1)
        else:  # Exploit
            idx = averages.index(max(averages))
        happiness = random.gauss(cafe_means[idx], cafe_dev[idx])
        # update the average for the cafe we just visited
        counts[idx] += 1
        averages[idx] += (happiness - averages[idx]) / counts[idx]
        total += happiness
    return total




#runs through all the functions and simulates the expected and actual values
#by running the functions and calculating expected happiness and regret values
def simulation(t,e=10):
    #optimum happiness value
    optimum_happiness = 300 * max(cafe_means)
    #values that will collect the total happiness values
    sim_explore_happiness = 0
    sim_exploit_happiness = 0
    sim_eGreedy_happiness = 0




    for i in range(t):#loops through all the functions to add the happiness values to the variables
        sim_explore_happiness += explore_only()
        sim_exploit_happiness += exploit_only(300)
        sim_eGreedy_happiness += eGreedy(cafe_means,cafe_devs,300,e)

    #expected happiness for explore only (each cafe is visited 100 times)
    expected_explore = 100 * sum(cafe_means)

    #finds all the average values of happiness by using the total happiness and dividing it
    #by the number of trials
    av_explore_happiness = sim_explore_happiness / t
    av_exploit_happiness = sim_exploit_happiness / t
    av_eGreedy_happiness = sim_eGreedy_happiness / t


    #finds all the regret by using optimum happiness minus av happiness
    explore_regret = optimum_happiness - av_explore_happiness
    exploit_regret = optimum_happiness - av_exploit_happiness
    eGreedy_regret = optimum_happiness - av_eGreedy_happiness


    #finds the expected regret by using the optimum happiness minus the expected happiness
    expect_regret_explore = optimum_happiness - expected_explore


    #prints optimum happiness
    print("Optimum Happiness:",f"{optimum_happiness:.2f}", "\n")
    #prints explore only's details
    print("Explore Only:")
    print("Expected Happiness:", f"{expected_explore:.2f}")
    print("Expected Regret:", f"{expect_regret_explore:.2f}")
    print("Simulated Happiness:", f"{av_explore_happiness:.2f}")
    print("Simulated Regret:", f"{explore_regret:.2f}","\n")


    #prints all the exploit only details
    print("Exploit Only:", "\n")
    print("Simulated Happiness:", f"{av_exploit_happiness:.2f}")
    print("Simulated Regret:", f"{exploit_regret:.2f}","\n")

    #prints all the eGreedy's details
    print("eGreedy:","\n")
    print("Simulated Happiness:", f"{av_eGreedy_happiness:.2f}")
    print("Simulated Regret:", f"{eGreedy_regret:.2f}")





print(simulation(300))
